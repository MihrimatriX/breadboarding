{
  "name": "breadboarding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tarayıcıda transistör seviyesinde, 3D CPU die simülatörü (visual6502 tarzı).",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run typecheck && npm test",
    "import:6502": "node scripts/import-visual6502.mjs",
    "cpu16": "node --experimental-strip-types --no-warnings cpu16/tools/cli.ts",
    "hesap8": "node --experimental-strip-types --no-warnings hesap8/arac.ts",
    "docker:build": "docker compose build web",
    "docker:up": "docker compose up -d --build web",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose up --build dev",
    "docker:test": "docker build --target test ."
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "three-mesh-bvh": "0.8.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.7.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
